# --- LLM (any OpenAI-compatible provider). Leave LLM_API_KEY empty to run without a model.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- GitHub (optional, raises the rate limit; read-only public access is enough)
GITHUB_TOKEN=

# --- Platform
DATABASE_URL=sqlite:///./devpilot.db
# DATABASE_URL=postgresql+psycopg://devpilot:devpilot@localhost:5432/devpilot
DEVPILOT_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_HOUR=30

# --- Limits
MAX_FILES=60
MAX_FILE_BYTES=100000
MAX_TOTAL_BYTES=1000000
MAX_RETRIES=2
MAX_PATCH_LINES=80

# --- Sandbox
SANDBOX_ENABLED=true
SANDBOX_IMAGE=devpilot-sandbox:latest
SANDBOX_TIMEOUT=60
USE_LANGGRAPH=true
